# 复制为 ops/deploy.env，或保存为 ~/.config/zglab/deploy.env。
# 该文件不应包含密码、私钥或 Token。

DEPLOY_SERVER=ubuntu@124.223.48.17

WEBSITE_URL=https://zglab.fun
TOOLS_URL=https://tools.zglab.fun

WEBSITE_REMOTE_ROOT=/var/www/zglab.fun
TOOLS_REMOTE_ROOT=/var/www/tools.zglab.fun
REMOTE_STAGE_ROOT=/tmp/zglab-release
REMOTE_BACKUP_ROOT=/var/backups/zglab-release

BACKUP_KEEP=10
DEPLOY_PULL=1

# 两个仓库不位于同一个 projects 目录时再填写：
