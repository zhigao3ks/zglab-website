---
import BaseLayout from './BaseLayout.astro';
import { noteCategoryLabels } from '../lib/notes';
import '../styles/notes.css';

interface Props {
  title: string;
  summary: string;
  date: Date;
  updated?: Date;
  category: string;
  tags: string[];
  readingMinutes: number;
  sourceUrl: string;
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { title, summary, date, updated, category, tags, readingMinutes, sourceUrl, headings } =
  Astro.props;
const tableOfContents = headings.filter(({ depth }) => depth === 2 || depth === 3);
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} — ZGLab Notes`} description={summary} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
  </Fragment>

  <header class="site-shell note-detail-hero">
    <a class="note-back" href="/notes">← 返回笔记索引</a>
    <p class="page-kicker">{noteCategoryLabels[category] ?? category}</p>
    <h1>{title}</h1>
    <p class="note-lead">{summary}</p>
    <div class="note-byline" aria-label="文章信息">
      <time datetime={date.toISOString()}>发布于 {dateFormatter.format(date)}</time>
      {
        updated && updated.getTime() !== date.getTime() && (
          <time datetime={updated.toISOString()}>更新于 {dateFormatter.format(updated)}</time>
        )
      }
      <span>{readingMinutes} 分钟阅读</span>
    </div>
  </header>

  <div class="site-shell note-detail-layout">
    <article class="note-prose prose">
      <slot />
    </article>
    <aside class="note-side" aria-label="文章辅助信息">
      {
        tableOfContents.length >= 2 && (
          <nav class="note-toc" aria-label="文章目录">
            <p class="note-side-title">本文目录</p>
            <ol>
              {tableOfContents.map((heading) => (
                <li data-depth={String(heading.depth)}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      {
        tags.length > 0 && (
          <section>
            <p class="note-side-title">关键词</p>
            <ul class="note-side-tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </section>
        )
      }

      <a class="note-source-link" href={sourceUrl} target="_blank" rel="noreferrer">
        在 GitHub 查看原文 ↗
      </a>
    </aside>
  </div>

  <div class="site-shell note-after">
    <slot name="after" />
  </div>

  <script>
    type MermaidRenderResult = {
      svg: string;
      bindFunctions?: (element: Element) => void;
    };

    type MermaidApi = {
      initialize: (configuration: Record<string, unknown>) => void;
      render: (id: string, source: string, container?: Element) => Promise<MermaidRenderResult>;
    };

    type MermaidDiagram = {
      figure: HTMLElement;
      viewport: HTMLElement;
      sourceDetails: HTMLDetailsElement;
      source: string;
    };

    const mermaidSourcePattern =
      /^(?:---[\s\S]*?---\s*)?(?:flowchart|graph|sequenceDiagram|classDiagram|stateDiagram(?:-v2)?|erDiagram|journey|gantt|pie|mindmap|timeline|gitGraph|quadrantChart|xychart-beta|sankey-beta|block-beta|packet-beta|architecture-beta)\b/;

    const isExplicitMermaidBlock = (block: HTMLElement, code: HTMLElement | null) =>
      block.dataset.language === 'mermaid' ||
      block.classList.contains('language-mermaid') ||
      code?.dataset.language === 'mermaid' ||
      code?.classList.contains('language-mermaid');

    const normalizeMermaidSource = (source: string) =>
      source
        .replace(/\r\n?/g, '\n')
        .replace(/<br\s*\/?>/gi, '<br/>')
        .trim();

    const createDiagram = (block: HTMLElement, source: string): MermaidDiagram => {
      const figure = document.createElement('figure');
      figure.className = 'mermaid-figure';

      const viewport = document.createElement('div');
      viewport.className = 'mermaid';
      viewport.setAttribute('role', 'img');
      viewport.setAttribute('aria-label', '文章流程图');
      viewport.innerHTML = '<span class="mermaid-loading">图表加载中…</span>';

      const sourceDetails = document.createElement('details');
      sourceDetails.className = 'mermaid-source';

      const summary = document.createElement('summary');
      summary.textContent = '查看图表源码';

      const sourcePre = document.createElement('pre');
      const sourceCode = document.createElement('code');
      sourceCode.textContent = source;
      sourcePre.append(sourceCode);
      sourceDetails.append(summary, sourcePre);

      figure.append(viewport, sourceDetails);
      block.replaceWith(figure);

      return { figure, viewport, sourceDetails, source };
    };

    const diagrams: MermaidDiagram[] = [];
    document.querySelectorAll<HTMLElement>('.note-prose pre').forEach((block) => {
      const code = block.querySelector<HTMLElement>('code');
      const source = normalizeMermaidSource(code?.textContent ?? block.textContent ?? '');
      if (!source) return;

      if (isExplicitMermaidBlock(block, code) || mermaidSourcePattern.test(source)) {
        diagrams.push(createDiagram(block, source));
      }
    });

    const mermaidModuleUrls = [
      'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs',
      'https://unpkg.com/mermaid@11/dist/mermaid.esm.min.mjs',
      'https://esm.sh/mermaid@11?bundle',
    ];

    const loadMermaid = async (): Promise<MermaidApi> => {
      let lastError: unknown;

      for (const moduleUrl of mermaidModuleUrls) {
        try {
          const imported = (await import(/* @vite-ignore */ moduleUrl)) as {
            default?: MermaidApi;
          } & MermaidApi;
          return (imported.default ?? imported) as MermaidApi;
        } catch (error) {
          lastError = error;
          console.warn(`[notes] Mermaid 模块加载失败，尝试备用地址：${moduleUrl}`, error);
        }
      }

      throw lastError ?? new Error('Mermaid 模块加载失败');
    };

    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
    const isDarkTheme = () => {
      const preference = document.documentElement.dataset.theme;
      return preference === 'dark' || (preference !== 'light' && prefersDark.matches);
    };

    const showDiagramError = (diagram: MermaidDiagram, error: unknown) => {
      diagram.figure.classList.add('is-error');
      diagram.viewport.textContent = '图表暂时无法渲染，源码已保留在下方。';
      diagram.sourceDetails.open = true;
      console.warn('[notes] Mermaid 图表渲染失败。', error, diagram.source);
    };

    let mermaid: MermaidApi | undefined;
    let renderSequence = 0;

    const renderDiagrams = async () => {
      if (!mermaid || diagrams.length === 0) return;

      renderSequence += 1;
      const currentSequence = renderSequence;
      const dark = isDarkTheme();

      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'antiscript',
        theme: dark ? 'dark' : 'default',
        flowchart: {
          htmlLabels: true,
          useMaxWidth: true,
        },
        sequence: {
          useMaxWidth: true,
        },
      });

      for (const [index, diagram] of diagrams.entries()) {
        if (currentSequence !== renderSequence) return;

        diagram.figure.classList.remove('is-error');
        diagram.sourceDetails.open = false;
        diagram.viewport.innerHTML = '<span class="mermaid-loading">图表加载中…</span>';

        try {
          const id = `mermaid-${Date.now()}-${currentSequence}-${index}`;
          const { svg, bindFunctions } = await mermaid.render(id, diagram.source, diagram.viewport);
          if (currentSequence !== renderSequence) return;

          diagram.viewport.innerHTML = svg;
          bindFunctions?.(diagram.viewport);
        } catch (error) {
          showDiagramError(diagram, error);
        }
      }
    };

    if (diagrams.length > 0) {
      loadMermaid()
        .then((loadedMermaid) => {
          mermaid = loadedMermaid;
          return renderDiagrams();
        })
        .catch((error) => {
          diagrams.forEach((diagram) => showDiagramError(diagram, error));
        });

      let rerenderTimer: number | undefined;
      const scheduleRerender = () => {
        window.clearTimeout(rerenderTimer);
        rerenderTimer = window.setTimeout(() => void renderDiagrams(), 120);
      };

      new MutationObserver((mutations) => {
        if (mutations.some((mutation) => mutation.attributeName === 'data-theme')) {
          scheduleRerender();
        }
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });

      prefersDark.addEventListener('change', () => {
        if (!document.documentElement.dataset.theme) scheduleRerender();
      });
    }
  </script>
</BaseLayout>
