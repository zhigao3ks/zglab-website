---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';
import '../styles/theme.css';

interface Props {
  title?: string;
  description?: string;
  ogType?: 'website' | 'article';
  image?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  ogType = 'website',
  image,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url);
const socialImage = image ? new URL(image, siteConfig.url) : undefined;
---

<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline>
      (() => {
        try {
          const preference = window.localStorage.getItem('zglab:theme');
          if (preference === 'dark' || preference === 'light') {
            document.documentElement.dataset.theme = preference;
          }
        } catch {
          // Theme persistence is optional; system preference remains available.
        }
      })();
    </script>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#151b20" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="ZGLab Notes" href="/notes/rss.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <slot name="head" />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
