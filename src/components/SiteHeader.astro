---
import { visibleNavigation } from '../config/navigation';
import { profile } from '../lib/data';
import GithubIcon from './GithubIcon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <div class="site-shell header-inner">
    <a class="brand" href="/" aria-label="ZGLab 首页">
      <span class="brand-mark" aria-hidden="true">ZG</span>
      <span class="brand-name">ZGLab</span>
      <span class="brand-index">/ 01</span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      <span>菜单</span>
      <span class="nav-toggle-lines" aria-hidden="true"></span>
    </button>

    <nav id="primary-navigation" class="primary-nav" aria-label="主导航">
      <ol>
        {
          visibleNavigation.map((item, index) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="nav-index">{String(index + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div class="header-actions">
      <button
        class="theme-switcher"
        type="button"
        data-theme-switcher
        title="当前主题：跟随系统。点击切换。"
        aria-label="当前主题：跟随系统。点击切换主题。"
      >
        <span class="theme-switcher-icon" aria-hidden="true">◐</span>
        <span class="theme-switcher-label" data-theme-label>跟随系统</span>
      </button>
      {
        profile.github && (
          <a
            class="icon-link"
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            aria-label="访问黄志高的 GitHub"
          >
            <GithubIcon />
          </a>
        )
      }
      {
        profile.email && (
          <a class="contact-link" href={`mailto:${profile.email}`}>
            联系我
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  type ThemePreference = 'system' | 'dark' | 'light';

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = document.querySelector<HTMLElement>('.primary-nav');
  const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-switcher]');
  const themeLabel = themeButton?.querySelector<HTMLElement>('[data-theme-label]');
  const themeColorMeta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const themeKey = 'zglab:theme';
  const preferences: ThemePreference[] = ['system', 'dark', 'light'];
  const labels: Record<ThemePreference, string> = {
    system: '跟随系统',
    dark: '深色',
    light: '浅色',
  };

  const getThemePreference = (): ThemePreference => {
    try {
      const value = window.localStorage.getItem(themeKey);
      return value === 'dark' || value === 'light' ? value : 'system';
    } catch {
      return 'system';
    }
  };

  const updateThemeColor = () => {
    const background = getComputedStyle(document.documentElement)
      .getPropertyValue('--color-bg')
      .trim();
    if (background) themeColorMeta?.setAttribute('content', background);
  };

  const updateThemeButton = (preference: ThemePreference) => {
    const label = labels[preference];
    if (themeLabel) themeLabel.textContent = label;
    if (themeButton) {
      themeButton.title = `当前主题：${label}。点击切换。`;
      themeButton.setAttribute('aria-label', `当前主题：${label}。点击切换主题。`);
    }
    window.requestAnimationFrame(updateThemeColor);
  };

  const setThemePreference = (preference: ThemePreference) => {
    try {
      if (preference === 'system') {
        window.localStorage.removeItem(themeKey);
        document.documentElement.removeAttribute('data-theme');
      } else {
        window.localStorage.setItem(themeKey, preference);
        document.documentElement.dataset.theme = preference;
      }
    } catch {
      if (preference === 'system') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.dataset.theme = preference;
    }
    updateThemeButton(preference);
  };

  let themePreference = getThemePreference();
  updateThemeButton(themePreference);

  themeButton?.addEventListener('click', () => {
    const nextIndex = (preferences.indexOf(themePreference) + 1) % preferences.length;
    themePreference = preferences[nextIndex];
    setThemePreference(themePreference);
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (themePreference === 'system') updateThemeColor();
  });

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    navigation?.classList.toggle('is-open', !expanded);
  });

  navigation?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      navigation.classList.remove('is-open');
    });
  });
</script>
