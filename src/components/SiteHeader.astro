---
import { visibleNavigation } from '../config/navigation';
import { profile } from '../lib/data';
import '../styles/navigation.css';
import GithubIcon from './GithubIcon.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === href : pathname === href || pathname.startsWith(`${href}/`);
const homeItem = visibleNavigation.find((item) => item.href === '/');
const secondaryItems = visibleNavigation.filter((item) => item.href !== '/');
const activeSecondaryIndex = secondaryItems.findIndex((item) => isActive(item.href));
const activeSecondary =
  activeSecondaryIndex >= 0 ? secondaryItems[activeSecondaryIndex] : undefined;
const collapsedRange = `02–${String(secondaryItems.length + 1).padStart(2, '0')}`;
---

<header class="site-header">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <div class="site-shell header-inner">
    <a class="brand" href="/" aria-label="ZGLab 首页">
      <span class="brand-mark" aria-hidden="true">ZG</span>
      <span class="brand-name">ZGLab</span>
      <span class="brand-index">/ 01</span>
    </a>

    <nav class="primary-nav" aria-label="主导航">
      {
        homeItem && (
          <a
            class="home-nav-link"
            href={homeItem.href}
            aria-current={isActive(homeItem.href) ? 'page' : undefined}
          >
            <span class="nav-index">01</span>
            <span class="nav-label">{homeItem.label}</span>
          </a>
        )
      }

      {
        secondaryItems.length > 0 && (
          <details class="nav-disclosure" data-nav-disclosure>
            <summary aria-label="展开站点导航">
              <span class="nav-index">
                {activeSecondary
                  ? String(activeSecondaryIndex + 2).padStart(2, '0')
                  : collapsedRange}
              </span>
              <span class="nav-label">{activeSecondary?.label ?? '浏览'}</span>
              <span class="nav-summary-icon" aria-hidden="true"></span>
            </summary>
            <ol class="nav-dropdown">
              {secondaryItems.map((item, index) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    <span class="nav-index">{String(index + 2).padStart(2, '0')}</span>
                    <span>{item.label}</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }
    </nav>

    <div class="header-actions">
      {
        profile.github && (
          <a
            class="icon-link"
            href={profile.github}
            target="_blank"
            rel="noreferrer"
            aria-label="访问黄志高的 GitHub"
          >
            <GithubIcon />
          </a>
        )
      }
      {
        profile.email && (
          <a class="contact-link" href={`mailto:${profile.email}`}>
            联系我
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  const disclosure = document.querySelector<HTMLDetailsElement>('[data-nav-disclosure]');

  disclosure?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      disclosure.open = false;
    });
  });

  document.addEventListener('click', (event) => {
    if (disclosure?.open && event.target instanceof Node && !disclosure.contains(event.target)) {
      disclosure.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && disclosure?.open) {
      disclosure.open = false;
      disclosure.querySelector('summary')?.focus();
    }
  });
</script>
