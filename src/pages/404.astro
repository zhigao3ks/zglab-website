---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 — ZGLab" description="请求的页面不存在。">
  <section class="site-shell page-hero">
    <div class="page-hero-copy">
      <p class="page-kicker">ERROR / 404</p>
      <h1>页面未找到</h1>
      <p>这个入口尚未建立，或内容已经移动。</p>
      <p><a class="button" href="/">返回首页</a></p>
    </div>
  </section>
</BaseLayout>
