---
import PageIntroDisclosure from '../components/PageIntroDisclosure.astro';
import StatusPill from '../components/StatusPill.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { ideas } from '../lib/data';
import { ideaStatusLabels } from '../lib/status';

const visibleIdeas = ideas.filter((idea) => idea.visible);
---

<BaseLayout
  title="想法与计划 — ZGLab"
  description="记录未来项目的探索方向、目标与推进状态。"
>
  <PageIntroDisclosure index="04" label="想法概览">
    <header class="site-shell page-hero">
      <div class="page-hero-copy">
        <p class="page-kicker">IDEA PIPELINE / LIFECYCLE</p>
        <h1>想法</h1>
        <p>记录值得继续探索的产品方向与研究命题，并按当前进展持续更新。</p>
      </div>
      <div class="page-hero-meta">
        <p>想法数量 <strong>{String(visibleIdeas.length).padStart(2, '0')}</strong></p>
        <p>推进阶段 <strong>探索 → 落地</strong></p>
        <p>关注范围 <strong>AI · 工具 · 知识</strong></p>
      </div>
    </header>
  </PageIntroDisclosure>

  <section class="page-section">
    <div class="site-shell">
      {
        visibleIdeas.length > 0 ? (
          <div class="ideas-full-grid">
            {visibleIdeas.map((idea, index) => (
              <article class="idea-full-card">
                <div>
                  <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                  <div style="margin-top: 1rem">
                    <StatusPill status={idea.status} label={ideaStatusLabels[idea.status]} />
                  </div>
                </div>
                <div>
                  <h2>{idea.title}</h2>
                  <p>{idea.summary}</p>
                  {idea.tags.length > 0 && (
                    <ul class="tag-list">
                      {idea.tags.map((tag) => (
                        <li>{tag}</li>
                      ))}
                    </ul>
                  )}
                  {idea.relatedProject && (
                    <a class="text-link" href={`/projects/${idea.relatedProject}/`}>
                      关联项目 ↗
                    </a>
                  )}
                </div>
              </article>
            ))}
          </div>
        ) : (
          <p class="empty-state">新的想法正在整理中。</p>
        )
      }
    </div>
  </section>
</BaseLayout>
